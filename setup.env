export EPICS_ROOT=/usr/local/epics
export EPICS_HOST_ARCH=linux-x86_64
export EPICS_BASE=${EPICS_ROOT}/base
export EPICS_BASE_BIN=${EPICS_BASE}/bin/${EPICS_HOST_ARCH}
export EPICS_BASE_LIB=${EPICS_BASE}/lib/${EPICS_HOST_ARCH}
if [ "" = "${LD_LIBRARY_PATH}" ]; then
 export LD_LIBRARY_PATH=${EPICS_BASE_LIB}
else
 export LD_LIBRARY_PATH=${EPICS_BASE_LIB}:${LD_LIBRARY_PATH}
fi
export PATH=${PATH}:${EPICS_BASE_BIN}

export TARGET_LIB=${EPICS_ROOT}/target/lib
export TARGET_INC=${EPICS_ROOT}/target/include

if [ ! -e $TARGET_LIB ]; then
	echo run setup_buildroot_links
fi


EPICS_EXTENSIONS=$EPICS_ROOT/extensions

# needed for building pvxs. If you have acq400_buildroot in the canonical place, you're good
# else, use BR_SYSROOT as a suffix to your buildroot top
export BR_SYSROOT=output/host/arm-buildroot-linux-gnueabihf/sysroot
export ACQ400_BUILDROOT_SYSROOT="$HOME/PROJECTS/ACQ400_ESW_TOP/acq400_buildroot/$BR_SYSROOT"

if [ ! -d $ACQ400_BUILDROOT_SYSROOT/usr/lib ]; then
	echo ACQ400_BUILDROOT_SYSROOT $ACQ400_BUILDROOT_SYSROOT does not look right
	echo '^C to abort and check'
	read thing
fi
if [ ! -e configure/CONFIG_SITE.linux-arm.Common ]; then
	cp -v configure/CONFIG_SITE.linux-arm.Common.template configure/CONFIG_SITE.linux-arm.Common
fi
if [ ! -e configure/CONFIG_SITE.local ]; then
	cp -v configure/CONFIG_SITE.local.template configure/CONFIG_SITE.local
fi
